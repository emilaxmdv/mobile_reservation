# ─────────────────────────────────────────────────────────────────────────────
# SERVER tərəf mühit dəyişənləri (Vercel API Routes üçün).
#
# PRODUCTION: bu dəyərlər Vercel → Project Settings → Environment Variables
# bölməsində saxlanılır.
#
# LOKAL TEST (`vercel dev`): bu faylı `.env` adı ilə kopyalayıb doldurun.
#
# QEYD: Heç bir dəyişəndə VITE_ prefiksi yoxdur — deməli heç biri brauzer
# bundle-ına düşmür, hamısı yalnız serverdə görünür.
#
# Köhnə WhatsApp dəyişənləri: legacy/whatsapp/env.example.whatsapp
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK service account açarı.
# Firebase Console → Project settings → Service accounts → Generate new private key
# Alınan JSON faylını base64-ə çevirib bura yazın. PowerShell ilə:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json")) | Set-Clipboard
# Birbaşa JSON string kimi də qəbul olunur.
FIREBASE_SERVICE_ACCOUNT_KEY=

# @BotFather-dən alınan bot token-i (məs: 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Yeni rezervasiya bildirişlərinin gedəcəyi çatın ID-si.
#  - Şəxsi çat: botu açıb /id yazın → "Bu çatın ID-si"
#  - Qrup: botu qrupa əlavə edin, qrupda /id yazın (qrup ID-si mənfi olur, məs: -1001234567890)
TELEGRAM_CHAT_ID=

# Təsdiq/Ləğv düymələrini basa və /bagla, /ac əmrlərini işlədə bilən işçilərin
# OPSİONAL: TELEGRAM_CHAT_ID qrupdursa, qrupun hər üzvü onsuz da icazəlidir.
# Bura yalnız qrupdan kənar icazə lazım olanların Telegram ID-ləri, vergüllə.
TELEGRAM_ADMIN_IDS=

# Webhook-u qoruyan təsadüfi sətir (yalnız A-Z, a-z, 0-9, _ və -; 1–256 simvol).
# Generasiya (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
TELEGRAM_WEBHOOK_SECRET=

# OPSİONAL: doğum günü xatırlatmalarının gedəcəyi ayrıca çat (məs. sahibin şəxsi
# çatı). Boş qalsa xatırlatmalar TELEGRAM_CHAT_ID-yə gedir.
TELEGRAM_OWNER_CHAT_ID=

# Təsadüfi sətir. Təyin olunsa, /api/birthday-check yalnız Vercel Cron-un öz
# çağırışlarını qəbul edir (Vercel bu dəyəri Authorization header-i ilə
# avtomatik göndərir). Generasiya: openssl rand -hex 32
CRON_SECRET=
