# ─────────────────────────────────────────────────────────────────────────────
# SERVER tərəf mühit dəyişənləri (Vercel API Routes üçün).
#
# PRODUCTION: bu dəyərlər Vercel → Project Settings → Environment Variables
# bölməsində saxlanılır (Firebase Secret Manager artıq İSTİFADƏ OLUNMUR).
#
# LOKAL TEST (`vercel dev`): bu faylı `.env` adı ilə kopyalayıb doldurun.
#
# QEYD: Heç bir dəyişəndə VITE_ prefiksi yoxdur — deməli heç biri brauzer
# bundle-ına düşmür, hamısı yalnız serverdə görünür. Frontend-in özünə artıq
# heç bir env dəyişəni lazım deyil (Firebase client SDK tamam çıxarılıb).
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK service account açarı.
# Firebase Console → Project settings → Service accounts → Generate new private key
# Alınan JSON faylını base64-ə çevirib bura yazın (tövsiyə olunur, çoxsətirli
# JSON ilə problem yaranmasın deyə). PowerShell ilə:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json")) | Set-Clipboard
# Birbaşa JSON string kimi də qəbul olunur.
FIREBASE_SERVICE_ACCOUNT_KEY=

# WhatsApp Cloud API daimi access token (Meta System User token)
WHATSAPP_TOKEN=

# Meta → WhatsApp → API Setup səhifəsindəki "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Webhook qeydiyyatı üçün özünüz uydurduğunuz təsadüfi sətir
# (Meta konsolunda webhook qoşanda eyni dəyəri yazacaqsınız)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Mütəxəssisin WhatsApp nömrəsi (Təsdiq/Ləğv düymələri buraya gedir)
# Format: ölkə kodu ilə, "+" işarəsiz. Məs: 994501234567
SPECIALIST_WHATSAPP_NUMBER=994501234567

# Mağaza sahibinin nömrəsi (doğum günü xatırlatmaları buraya gedir).
# Boş qalsa xatırlatmalar mütəxəssisin nömrəsinə göndərilir.
OWNER_WHATSAPP_NUMBER=

# Müştəriyə ləğv mesajında göndərilən yenidən-rezervasiya linki
BOOKING_LINK=https://your-site.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# TÖVSİYƏ OLUNAN əlavə qoruma dəyişənləri
# ─────────────────────────────────────────────────────────────────────────────

# Meta App Secret (App Dashboard → Settings → Basic → App secret).
# Təyin olunsa, webhook-a gələn hər POST-un X-Hub-Signature-256 imzası
# yoxlanılır — saxta sorğularla status dəyişmək mümkün olmur. Boş qalsa
# yoxlama SÖNÜLÜdür (yalnız test üçün məqbuldur).
META_APP_SECRET=

# Təsadüfi sətir. Təyin olunsa, /api/birthday-check yalnız Vercel Cron-un öz
# çağırışlarını qəbul edir (Vercel bu dəyəri Authorization header-i ilə
# avtomatik göndərir). Generasiya: openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPSİONAL: Meta-da təsdiqlənmiş "utility" template adları.
# Müştəri biznesə heç vaxt yazmayıbsa (bizim ssenaridə belədir — o, veb formu
# doldurur), 24 saatlıq service window açıq deyil və sərbəst mətn mesajı ona
# ÇATMAYACAQ. Bu template adları təyin olunubsa, sistem müştəriyə template ilə
# yazır; boş qalsa, sərbəst mətn cəhd edilir (yalnız açıq pəncərədə işləyir).
# Template mətnləri üçün README-dəki "WhatsApp template-ləri" bölməsinə baxın.
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_CONFIRM_TEMPLATE=
WHATSAPP_DECLINE_TEMPLATE=
